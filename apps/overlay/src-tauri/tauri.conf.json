{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RocketStats",
  "version": "0.1.0",
  "identifier": "com.rocketstats.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RocketStats Overlay",
        "width": 1280,
        "height": 720,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      },
      {
        "label": "settings",
        "title": "RocketStats Settings",
        "url": "/settings.html",
        "width": 480,
        "height": 520,
        "visible": false,
        "decorations": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
